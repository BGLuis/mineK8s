{
  "name": "@minek8s/control-plane",
  "version": "0.1.0",
  "description": "MineKubernetes Control Plane API & Orchestrator",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch --preserveWatchOutput",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts"
  },
  "dependencies": {
    "@kubernetes/client-node": "^2.0.0",
    "@nestjs/common": "^12.1.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.1",
    "@nestjs/platform-express": "^12.1.1",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/typeorm": "^12.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.3.0",
    "joi": "^17.13.3",
    "nestjs-pino": "^5.2.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.28",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.1.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.12",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@types/yauzl": "^3.4.0",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "@swc/jest"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(@nestjs|es-toolkit)/)"
    ],
    "setupFiles": [
      "<rootDir>/../test/jest-setup.ts"
    ],
    "moduleNameMapper": {
      "^@nestjs/common$": "<rootDir>/../test/mocks/nestjs-common.mock.ts",
      "^@nestjs/core$": "<rootDir>/../test/mocks/nestjs-core.mock.ts",
      "^@nestjs/platform-express$": "<rootDir>/../test/mocks/nestjs-platform-express.mock.ts",
      "^@nestjs/config$": "<rootDir>/../test/mocks/nestjs-config.mock.ts",
      "^@nestjs/typeorm$": "<rootDir>/../test/mocks/nestjs-typeorm.mock.ts",
      "^@/(.*)$": "<rootDir>/$1",
      "^@config/(.*)$": "<rootDir>/config/$1",
      "^@logging/(.*)$": "<rootDir>/logging/$1",
      "^@database/(.*)$": "<rootDir>/database/$1",
      "^@common/(.*)$": "<rootDir>/common/$1",
      "^@servers/(.*)$": "<rootDir>/servers/$1",
      "^@k8s/(.*)$": "<rootDir>/k8s/$1",
      "^@auth/(.*)$": "<rootDir>/auth/$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
