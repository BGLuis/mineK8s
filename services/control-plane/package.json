{
  "name": "@minek8s/control-plane",
  "version": "0.1.0",
  "description": "MineKubernetes Control Plane API & Orchestrator",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch --preserveWatchOutput",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typecheck": "tsc --noEmit",
    "admin:link": "ts-node -r tsconfig-paths/register src/cli/admin-link.ts",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.8.1",
    "@kubernetes/client-node": "^2.0.0",
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/microservices": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/platform-socket.io": "^12.1.3",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/typeorm": "^12.0.2",
    "@nestjs/websockets": "^12.1.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "joi": "^18.3.0",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.4",
    "typeorm": "^1.1.2",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.7",
    "@nestjs/testing": "^12.1.3",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.18",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.2.1",
    "@types/yauzl": "^3.4.0",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "@swc/jest"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(@nestjs|es-toolkit|@kubernetes/client-node|openid-client|oauth4webapi|jose|socks-proxy-agent|agent-base)/)"
    ],
    "setupFiles": [
      "<rootDir>/../test/jest-setup.ts"
    ],
    "moduleNameMapper": {
      "^@nestjs/common$": "<rootDir>/../test/mocks/nestjs-common.mock.ts",
      "^@nestjs/core$": "<rootDir>/../test/mocks/nestjs-core.mock.ts",
      "^@nestjs/platform-express$": "<rootDir>/../test/mocks/nestjs-platform-express.mock.ts",
      "^@nestjs/config$": "<rootDir>/../test/mocks/nestjs-config.mock.ts",
      "^@nestjs/typeorm$": "<rootDir>/../test/mocks/nestjs-typeorm.mock.ts",
      "^@nestjs/websockets$": "<rootDir>/../test/mocks/nestjs-websockets.mock.ts",
      "^@nestjs/microservices$": "<rootDir>/../test/mocks/nestjs-microservices.mock.ts",
      "^@nestjs/swagger$": "<rootDir>/../test/mocks/nestjs-swagger.mock.ts",
      "^@/(.*)$": "<rootDir>/$1",
      "^@config/(.*)$": "<rootDir>/config/$1",
      "^@logging/(.*)$": "<rootDir>/logging/$1",
      "^@database/(.*)$": "<rootDir>/database/$1",
      "^@common/(.*)$": "<rootDir>/common/$1",
      "^@servers/(.*)$": "<rootDir>/servers/$1",
      "^@k8s/(.*)$": "<rootDir>/k8s/$1",
      "^@auth/(.*)$": "<rootDir>/auth/$1",
      "^@rcon/(.*)$": "<rootDir>/rcon/$1",
      "^@console/(.*)$": "<rootDir>/console/$1",
      "^@terminal/(.*)$": "<rootDir>/terminal/$1",
      "^@tailscale/(.*)$": "<rootDir>/tailscale/$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
