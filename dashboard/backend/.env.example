# ─── NestJS Principal (porta 3000, privado) ───────────────────────────────────
PORT=3000

# ─── Join Server (porta 3001, exposto via Tailscale Funnel) ───────────────────
JOIN_PORT=3001

# ─── Tailscale ────────────────────────────────────────────────────────────────
# Tailnet: o nome da sua rede Tailscale.
# Encontre em: https://login.tailscale.com/admin/dns → "Tailnet name"
# Exemplo: "seu-usuario.github" ou "tail1234abcd.ts.net"
# Use "-" para deixar o SDK resolver automaticamente (recomendado)
TAILSCALE_TAILNET=-

# API Token do Tailscale (PAT - Personal Access Token da sua conta Admin)
# Crie em: https://login.tailscale.com/admin/settings/keys
# OBS: O OAuth Client nativo "trava" as tags na criação. Como estamos usando
# controle granular dinâmico, o NestJS vai atualizar seu ACL via API
# e gerar convites na hora. Um PAT herda todas as suas permissões de admin.
TAILSCALE_API_TOKEN=tskey-client-xxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx

# ─── Tailscale Funnel Host (OPCIONAL na primeira vez) ────────────────────────
#
# ⚠️  Problema de bootstrap: você só sabe o hostname DEPOIS de instalar
#     o Tailscale no nó. Por isso, esta variável é OPCIONAL no início.
#
# Sem ela: o sistema sobe normalmente. O link de convite gerado apontará
#           para "http://localhost:3001" — funcional para testes locais.
#
# Com ela: o link de convite gerado será "https://SEU-HOST.ts.net/join#KEY"
#           — o link correto que você envia para jogadores entrarem.
#
# ── Ordem correta de configuração ─────────────────────────────────────────────
#
# 1. DEIXE ESTA LINHA COMENTADA (ou vazia) e suba o sistema pela primeira vez.
#
# 2. No nó onde o sistema roda, instale e autentique o Tailscale:
#      curl -fsSL https://tailscale.com/install.sh | sh
#      tailscale up --authkey=<SUA_AUTH_KEY> --hostname=minecraft-dashboard
#
# 3. Ative o Funnel na porta 3001 (a porta do join-server):
#      tailscale funnel --bg 3001
#
# 4. Descubra o hostname que o Tailscale atribuiu ao nó:
#      tailscale status --json | jq -r '.Self.DNSName'
#    Exemplo de retorno: "minecraft-dashboard.tail1234abcd.ts.net."
#                                                                 ↑ ignore o "." final
#
# 5. Preencha a variável abaixo (sem barra final, sem porta, sem o "." final):
#      TAILSCALE_FUNNEL_HOST=minecraft-dashboard.tail1234abcd.ts.net
#
# 6. Reinicie o backend para o novo hostname ser carregado.
#
# Docs Funnel: https://tailscale.com/kb/1223/funnel
# TAILSCALE_FUNNEL_HOST=minecraft-dashboard.tail1234abcd.ts.net

# ─── Infraestrutura ───────────────────────────────────────────────────────────
# Configurações do Banco de Dados (Prisma)
DATABASE_URL="file:./dev.db"

# Domínio base para roteamento dos servidores via DNS/Gateway (ex: "mine.com")
MINEKUBE_BASE_DOMAIN=mine.com
