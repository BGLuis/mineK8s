NODE_ENV=production
# hostNetwork: these ports open on the node itself (3000 is taken on luisarch).
PORT=8080
GRPC_HOST=0.0.0.0
GRPC_PORT=50051
ENABLE_SWAGGER=false
NODE_OPTIONS=--max-old-space-size=384

DB_HOST=postgres.minekubernetes.svc.cluster.local
DB_PORT=5432
DB_USER=minek8s
DB_NAME=minekubernetes

TAILSCALE_SOCKET_PATH=/run/tailscale/tailscaled.sock
TAILSCALE_AUTH_ENABLED=true

KUBERNETES_IN_CLUSTER=true
KUBERNETES_NAMESPACE=minekubernetes

SERVERS_DATA_ROOT=/srv/servers
BACKUPS_PATH=/backups
SHARED_CACHE_PATH=/cache

LOG_LEVEL=context=*;level=info
