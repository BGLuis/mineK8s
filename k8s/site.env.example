# Copy to k8s/site.env (not versioned) and fill in. kubectl apply -k k8s turns it into the
# control-plane-site Secret; changing it and applying again restarts the control plane.

# Same password for Postgres and the control plane. Generate with: openssl rand -hex 24
DB_PASSWORD=
# At least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=

# Where the panel is opened. Socket.IO (console, live state) only accepts these origins.
API_URL=http://luisarch:8080
APP_URL=http://luisarch:8080
ALLOWED_ORIGINS=http://luisarch:8080,http://100.109.250.127:8080

# Tailscale Cloud API: generates the invite pre-auth keys and removes devices.
TAILSCALE_API_KEY=
TAILNET_NAME=

# Optional: token for creating the first admin. Empty: the control plane logs one at boot.
INITIAL_BOOTSTRAP_TOKEN=
