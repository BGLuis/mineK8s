# ==============================================================================
# MineKubernetes - Control Plane & Cluster Environment Variables
# Ref: PR-03..PR-08, PR-16..PR-20 (Issue #61)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Runtime & Application Server
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
APP_URL=http://localhost:4200
ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
ENABLE_SWAGGER=true

# ------------------------------------------------------------------------------
# 2. Database - PostgreSQL 16 (PR-16, RF-RCON-10)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=minek8s
DB_PASSWORD=minek8s_secret_change_in_production
DB_NAME=minekubernetes
DB_SSL=false
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_POOL_SIZE=10

# ------------------------------------------------------------------------------
# 3. Security, RBAC & API Authentication (PR-15, RF-ARQ-24, L-01)
# ------------------------------------------------------------------------------
# Secret key with at least 32 characters for signing JWT access tokens
JWT_SECRET=minek8s_jwt_super_secret_key_minimum_32_chars_long
JWT_EXPIRATION=1d

# Ephemeral bootstrap token for creating the initial administrator account.
# If left empty, the Control Plane will generate one on startup if no admin exists.
INITIAL_BOOTSTRAP_TOKEN=

# ------------------------------------------------------------------------------
# 4. Tailscale Integration (PR-17, RF-TS-01..10, L-01)
# ------------------------------------------------------------------------------
TAILSCALE_SOCKET_PATH=/run/tailscale/tailscaled.sock
TAILSCALE_AUTH_ENABLED=true
TAILSCALE_API_KEY=
TAILNET_NAME=

# Trusted reverse proxies for PROXY Protocol v2 and ingress (PR-17, GW:420)
# Comma-separated list of IP addresses or CIDR ranges
TRUSTED_PROXY_IPS=127.0.0.1/32,100.64.0.0/10

# ------------------------------------------------------------------------------
# 5. Kubernetes Cluster & Orchestration (PR-03..06, PR-19, RF-ARQ-09..15)
# ------------------------------------------------------------------------------
# Set to 'true' when running inside a Kubernetes Pod using ServiceAccount
KUBERNETES_IN_CLUSTER=false
# Path to local kubeconfig when developing outside cluster (defaults to ~/.kube/config)
KUBECONFIG=
# Dedicated namespace for all hypervisor resources (PR-06, C-11)
KUBERNETES_NAMESPACE=minekubernetes
# Node pinning and affinity configuration (PR-03, RF-STO-06)
KUBERNETES_NODE_AFFINITY_KEY=kubernetes.io/hostname
KUBERNETES_NODE_AFFINITY_VALUE=

# ------------------------------------------------------------------------------
# 6. Container Image Registry (PR-07, PR-08, C-18)
# ------------------------------------------------------------------------------
REGISTRY_URL=docker.io
IMAGE_JVM_RUNNER=eclipse-temurin:21-jre-jammy
IMAGE_INSTALLER_JOB=minekubernetes/installer:latest
IMAGE_CONTROL_PLANE=minekubernetes/control-plane:latest
IMAGE_GATEWAY=minekubernetes/gateway:latest

# ------------------------------------------------------------------------------
# 7. Storage & Mount Paths (PR-03..05, RF-STO-06..08)
# ------------------------------------------------------------------------------
# Local filesystem path for servers /data volumes (development fallback)
SERVERS_DATA_ROOT=./storage/servers
# Shared modpack cache path mapped to PVC shared-modpack-cache (PR-05)
SHARED_CACHE_PATH=/cache
# Backup storage path mapped to PVC backup-storage (PR-04)
BACKUPS_PATH=/backups

# ------------------------------------------------------------------------------
# 8. Observability & Logging (Padrão Feeder / PR-20)
# ------------------------------------------------------------------------------
# Dynamic logging rules (supports per-context levels separated by /)
# Example: context=*;level=info/context=KubernetesService;level=debug
LOG_LEVEL=context=*;level=info/context=KubernetesService;level=debug

# Prometheus telemetry (PR-20, GW:525)
METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_PATH=/metrics
